# ============================================================
# HexAudit — Smart Contract Security Auditor
# Environment configuration (copy to .env and adjust)
# ============================================================

# --- Backend ---
# Port the Express API + WebSocket server listens on.
PORT=3001

# Comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
# Base URL the web UI uses to reach the backend (dev-server proxy is used by default).
VITE_API_URL=http://localhost:3001

# --- Optional tuneables ---
# Rate limit: max requests per IP per minute (backend).
RATE_LIMIT_MAX=30